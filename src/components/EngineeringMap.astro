<script is:inline>
  (() => {
    if (typeof window === 'undefined') return;

    const setupVistaHero = () => {
      const cards = document.querySelectorAll('.engineering-map--robot');
      if (!cards.length) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      const reset = (card) => {
        card.style.setProperty('--robot-pan-x', '0px');
        card.style.setProperty('--robot-pan-y', '0px');
        card.style.setProperty('--robot-head-x', '0px');
        card.style.setProperty('--robot-head-y', '0px');
        card.style.setProperty('--robot-arm-left-x', '0px');
        card.style.setProperty('--robot-arm-left-y', '0px');
        card.style.setProperty('--robot-arm-right-x', '0px');
        card.style.setProperty('--robot-arm-right-y', '0px');
        card.style.setProperty('--robot-glow-x', '0px');
        card.style.setProperty('--robot-glow-y', '0px');
      };

      cards.forEach((card) => {
        if (card.dataset.vistaInteractiveReady === 'true') return;
        card.dataset.vistaInteractiveReady = 'true';
        reset(card);

        if (reducedMotion.matches) return;

        const onPointerMove = (event) => {
          const rect = card.getBoundingClientRect();
          const px = ((event.clientX - rect.left) / rect.width) * 2 - 1;
          const py = ((event.clientY - rect.top) / rect.height) * 2 - 1;

          card.style.setProperty('--robot-pan-x', `${(px * 18).toFixed(2)}px`);
          card.style.setProperty('--robot-pan-y', `${(py * 14).toFixed(2)}px`);
          card.style.setProperty('--robot-head-x', `${(px * 7).toFixed(2)}px`);
          card.style.setProperty('--robot-head-y', `${(py * 5).toFixed(2)}px`);
          card.style.setProperty('--robot-arm-left-x', `${(-px * 10).toFixed(2)}px`);
          card.style.setProperty('--robot-arm-left-y', `${(-py * 6).toFixed(2)}px`);
          card.style.setProperty('--robot-arm-right-x', `${(px * 10).toFixed(2)}px`);
          card.style.setProperty('--robot-arm-right-y', `${(-py * 8).toFixed(2)}px`);
          card.style.setProperty('--robot-glow-x', `${(px * 24).toFixed(2)}px`);
          card.style.setProperty('--robot-glow-y', `${(py * 18).toFixed(2)}px`);
        };

        card.addEventListener('pointermove', onPointerMove);
        card.addEventListener('pointerleave', () => reset(card));
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupVistaHero, { once: true });
    } else {
      setupVistaHero();
    }
  })();
</script>
