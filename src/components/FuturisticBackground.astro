<div class="future-background" aria-hidden="true" data-future-background>
  <canvas data-network-canvas></canvas>
  <div class="future-background__grid"></div>
  <div class="future-background__section-focus"></div>
  <div class="future-background__datum future-background__datum--left"><i></i><i></i><i></i></div>
  <div class="future-background__datum future-background__datum--right"><i></i><i></i><i></i></div>

  <div class="future-background__technical">
    <div class="future-background__trace future-background__trace--one"></div>
    <div class="future-background__trace future-background__trace--two"></div>
    <div class="future-background__trace future-background__trace--three"></div>
    <div class="future-background__gear future-background__gear--one"></div>
    <div class="future-background__gear future-background__gear--two"></div>
    <div class="future-background__wave future-background__wave--one"></div>
    <div class="future-background__wave future-background__wave--two"></div>
    <span class="future-background__blip future-background__blip--one"></span>
    <span class="future-background__blip future-background__blip--two"></span>
    <span class="future-background__blip future-background__blip--three"></span>
  </div>

  <div class="future-background__aurora"></div>
  <div class="future-background__cursor"></div>
</div>

<script is:inline>
  (() => {
    const init = () => {
      const root = document.querySelector('[data-future-background]');
      const canvas = root?.querySelector('[data-network-canvas]');
      if (!(root instanceof HTMLElement) || !(canvas instanceof HTMLCanvasElement)) return;

      const context = canvas.getContext('2d');
      if (!context) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const finePointer = window.matchMedia('(pointer: fine)');
      const nodes = [];
      const pointer = {
        x: window.innerWidth * 0.72,
        y: window.innerHeight * 0.28,
        tx: window.innerWidth * 0.72,
        ty: window.innerHeight * 0.28,
        vx: 0,
        vy: 0,
        active: false
      };
      let width = 0;
      let height = 0;
      let ratio = 1;
      let frame = 0;
      let running = false;
      let lastTime = 0;

      const clamp = (value, min, max) => Math.min(max, Math.max(min, value));

      const randomNode = () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.18,
        vy: (Math.random() - 0.5) * 0.18,
        drift: Math.random() * 0.012 + 0.004,
        radius: Math.random() * 0.9 + 0.45,
        tone: Math.random() > 0.74 ? 'violet' : Math.random() > 0.42 ? 'blue' : 'cyan',
        phase: Math.random() * Math.PI * 2,
        pulse: Math.random() * 0.9 + 0.6
      });

      const syncDecor = () => {
        const driftX = clamp(pointer.vx * 18, -24, 24);
        const driftY = clamp(pointer.vy * 18, -24, 24);
        root.style.setProperty('--cursor-x', `${pointer.x}px`);
        root.style.setProperty('--cursor-y', `${pointer.y}px`);
        root.style.setProperty('--drift-x', `${driftX}px`);
        root.style.setProperty('--drift-y', `${driftY}px`);
        root.style.setProperty('--drift-soft-x', `${(driftX * .34).toFixed(2)}px`);
        root.style.setProperty('--drift-soft-y', `${(driftY * .34).toFixed(2)}px`);
        root.style.setProperty('--drift-medium-x', `${(driftX * .62).toFixed(2)}px`);
        root.style.setProperty('--drift-medium-y', `${(driftY * .62).toFixed(2)}px`);
      };

      const resize = () => {
        ratio = Math.min(window.devicePixelRatio || 1, 1.5);
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = Math.round(width * ratio);
        canvas.height = Math.round(height * ratio);
        canvas.style.width = `${width}px`;
        canvas.style.height = `${height}px`;
        context.setTransform(ratio, 0, 0, ratio, 0, 0);

        const targetCount = Math.max(30, Math.min(64, Math.round(width / 22)));
        nodes.length = 0;
        for (let index = 0; index < targetCount; index += 1) nodes.push(randomNode());

        if (!pointer.active) {
          pointer.x = width * 0.72;
          pointer.y = height * 0.28;
          pointer.tx = pointer.x;
          pointer.ty = pointer.y;
          syncDecor();
        }

        draw(0);
      };

      const drawWaveBand = (time, bandIndex) => {
        const baseY = height * (0.2 + bandIndex * 0.22);
        const amplitude = 10 + bandIndex * 5;
        const speed = 0.00022 + bandIndex * 0.00005;
        const frequency = 0.008 + bandIndex * 0.0012;
        const influence = (pointer.x / Math.max(width, 1) - 0.5) * (14 + bandIndex * 6);

        context.beginPath();
        for (let x = -40; x <= width + 40; x += 22) {
          const y = baseY
            + Math.sin(x * frequency + time * speed + bandIndex * 0.9) * amplitude
            + Math.cos(x * (frequency * 0.4) - time * speed * 1.6) * (amplitude * 0.36)
            + influence;
          if (x === -40) context.moveTo(x, y);
          else context.lineTo(x, y);
        }
        context.strokeStyle = bandIndex === 0
          ? 'rgba(92,225,230,.10)'
          : bandIndex === 1
            ? 'rgba(102,124,255,.085)'
            : 'rgba(181,108,255,.075)';
        context.lineWidth = bandIndex === 1 ? 1.2 : 0.9;
        context.stroke();
      };

      const drawTelemetry = (time) => {
        const lineCount = 4;
        for (let index = 0; index < lineCount; index += 1) {
          const y = height * (0.66 + index * 0.065);
          const start = ((time * (0.04 + index * 0.01)) % (width + 320)) - 220;
          const length = 180 + index * 30;
          const gradient = context.createLinearGradient(start, y, start + length, y);
          gradient.addColorStop(0, 'rgba(92,225,230,0)');
          gradient.addColorStop(0.35, 'rgba(92,225,230,0.08)');
          gradient.addColorStop(0.75, 'rgba(102,124,255,0.07)');
          gradient.addColorStop(1, 'rgba(181,108,255,0)');

          context.beginPath();
          context.moveTo(start, y);
          context.lineTo(start + length, y);
          context.strokeStyle = gradient;
          context.lineWidth = 1;
          context.stroke();
        }
      };

      const draw = (time = 0) => {
        context.clearRect(0, 0, width, height);

        pointer.x += (pointer.tx - pointer.x) * 0.12;
        pointer.y += (pointer.ty - pointer.y) * 0.12;
        pointer.vx *= 0.9;
        pointer.vy *= 0.9;
        syncDecor();

        drawWaveBand(time, 0);
        drawWaveBand(time, 1);
        drawWaveBand(time, 2);
        drawTelemetry(time);

        for (let first = 0; first < nodes.length; first += 1) {
          const a = nodes[first];

          if (!reducedMotion.matches && time - lastTime > 7) {
            a.x += a.vx + Math.sin(time * 0.00022 + a.phase) * a.drift;
            a.y += a.vy + Math.cos(time * 0.00016 + a.phase) * a.drift;
          }

          const pointerDx = pointer.x - a.x;
          const pointerDy = pointer.y - a.y;
          const pointerDistance = Math.hypot(pointerDx, pointerDy);
          if (finePointer.matches && pointerDistance < 190) {
            const force = ((190 - pointerDistance) / 190) ** 2;
            a.x += pointer.vx * 3.2 * force + pointerDx * 0.008 * force;
            a.y += pointer.vy * 3.2 * force + pointerDy * 0.008 * force;
          }

          if (a.x < -16) a.x = width + 16;
          if (a.x > width + 16) a.x = -16;
          if (a.y < -16) a.y = height + 16;
          if (a.y > height + 16) a.y = -16;

          for (let second = first + 1; second < nodes.length; second += 1) {
            const b = nodes[second];
            const dx = a.x - b.x;
            const dy = a.y - b.y;
            const distance = Math.hypot(dx, dy);
            if (distance < 138) {
              context.beginPath();
              context.moveTo(a.x, a.y);
              context.lineTo(b.x, b.y);
              context.strokeStyle = `rgba(92, 225, 230, ${0.045 * (1 - distance / 138)})`;
              context.lineWidth = 0.7;
              context.stroke();
            }
          }

          const pulse = (Math.sin(time * 0.0012 * a.pulse + a.phase) + 1) / 2;
          const radius = a.radius + pulse * 0.35;
          context.beginPath();
          context.arc(a.x, a.y, radius, 0, Math.PI * 2);
          context.fillStyle = a.tone === 'violet'
            ? 'rgba(181,108,255,.36)'
            : a.tone === 'blue'
              ? 'rgba(102,124,255,.34)'
              : 'rgba(92,225,230,.42)';
          context.fill();
        }

        lastTime = time;
        if (running && !reducedMotion.matches) frame = requestAnimationFrame(draw);
      };

      const start = () => {
        cancelAnimationFrame(frame);
        running = !document.hidden && !reducedMotion.matches;
        if (running) frame = requestAnimationFrame(draw);
        else draw(performance.now());
      };

      const updatePointer = (event) => {
        pointer.active = true;
        pointer.tx = event.clientX;
        pointer.ty = event.clientY;
        pointer.vx = clamp((event.movementX || 0) * 0.12, -1.1, 1.1);
        pointer.vy = clamp((event.movementY || 0) * 0.12, -1.1, 1.1);
      };

      const resetPointer = () => {
        pointer.active = false;
        pointer.tx = width * 0.72;
        pointer.ty = height * 0.28;
        pointer.vx = 0;
        pointer.vy = 0;
      };

      const sectionProfiles = {
        home:       { x: '72%', y: '28%', energy: '.86', phase: '0deg' },
        about:      { x: '20%', y: '46%', energy: '.72', phase: '18deg' },
        education:  { x: '78%', y: '52%', energy: '.68', phase: '42deg' },
        skills:     { x: '34%', y: '60%', energy: '.76', phase: '66deg' },
        projects:   { x: '76%', y: '40%', energy: '.9',  phase: '92deg' },
        experience: { x: '24%', y: '58%', energy: '.7',  phase: '116deg' },
        contact:    { x: '70%', y: '62%', energy: '.8',  phase: '148deg' },
        case:       { x: '72%', y: '34%', energy: '.82', phase: '94deg' }
      };

      const setActiveSection = (name) => {
        const profile = sectionProfiles[name] || sectionProfiles.case;
        document.documentElement.dataset.activeSection = name;
        root.dataset.activeSection = name;
        root.style.setProperty('--field-focus-x', profile.x);
        root.style.setProperty('--field-focus-y', profile.y);
        root.style.setProperty('--field-energy', profile.energy);
        root.style.setProperty('--field-phase', profile.phase);
      };

      let scrollTicking = false;
      const updateScroll = () => {
        const doc = document.documentElement;
        const scrollMax = Math.max(doc.scrollHeight - window.innerHeight, 1);
        const progress = clamp(window.scrollY / scrollMax, 0, 1);
        root.style.setProperty('--scroll-progress', progress.toFixed(4));
        root.style.setProperty('--scroll-shift', `${Math.round(progress * 180)}px`);
        root.style.setProperty('--scroll-grid-x', `${(progress * 18).toFixed(2)}px`);
        root.style.setProperty('--scroll-grid-y', `${(progress * -11).toFixed(2)}px`);
        root.style.setProperty('--scroll-tech-y', `${(progress * -6.3).toFixed(2)}px`);
        root.style.setProperty('--scroll-rotation', `${(progress * 14).toFixed(2)}deg`);
        scrollTicking = false;
      };

      const requestScrollUpdate = () => {
        if (scrollTicking) return;
        scrollTicking = true;
        requestAnimationFrame(updateScroll);
      };

      const observeSections = () => {
        const sections = [...document.querySelectorAll('main section[id]')];
        if (!sections.length) {
          setActiveSection(document.querySelector('.case-study') ? 'case' : 'home');
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
          if (visible[0]?.target instanceof HTMLElement) setActiveSection(visible[0].target.id || 'case');
        }, { rootMargin: '-24% 0px -46% 0px', threshold: [0.05, 0.2, 0.45, 0.7] });

        sections.forEach((section) => observer.observe(section));
        setActiveSection(sections[0]?.id || 'home');
      };

      const enhanceInteractiveCards = () => {
        const interactiveCards = document.querySelectorAll('.project-card, .skill-card, .education-card, .lab-card, .contact-panel, .about-stat-card, .credential-card');
        interactiveCards.forEach((card) => {
          if (!(card instanceof HTMLElement) || card.dataset.interactionReady === 'true') return;
          card.dataset.interactionReady = 'true';
          card.addEventListener('pointermove', (event) => {
            if (!finePointer.matches) return;
            const bounds = card.getBoundingClientRect();
            const x = (event.clientX - bounds.left) / bounds.width;
            const y = (event.clientY - bounds.top) / bounds.height;
            card.style.setProperty('--card-x', `${x * 100}%`);
            card.style.setProperty('--card-y', `${y * 100}%`);
            card.style.setProperty('--tilt-x', `${(0.5 - y) * 3.5}deg`);
            card.style.setProperty('--tilt-y', `${(x - 0.5) * 3.5}deg`);
          });
          card.addEventListener('pointerleave', () => {
            card.style.setProperty('--card-x', '50%');
            card.style.setProperty('--card-y', '50%');
            card.style.setProperty('--tilt-x', '0deg');
            card.style.setProperty('--tilt-y', '0deg');
          });
        });
      };

      resize();
      enhanceInteractiveCards();
      observeSections();
      updateScroll();
      start();
      window.addEventListener('resize', () => { resize(); updateScroll(); }, { passive: true });
      window.addEventListener('scroll', requestScrollUpdate, { passive: true });
      window.addEventListener('pointermove', updatePointer, { passive: true });
      window.addEventListener('pointerleave', resetPointer, { passive: true });
      document.addEventListener('visibilitychange', start);
      reducedMotion.addEventListener('change', start);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
</script>
