---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---
<BaseLayout title="404 — Izhaan Mubeen" description="Page not found.">
  <Header />
  <main id="main" class="not-found shell">
    <p class="eyebrow">SYSTEM / 404</p>
    <h1>That route isn’t in the assembly.</h1>
    <p>The page may have moved, or the case study is not part of this local build.</p>
    <a class="button button--primary" href="/#projects">Return to projects</a>
  </main>
</BaseLayout>
