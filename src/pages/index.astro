      <a href="#home">Back to top ↑</a>
    </div>
  </footer>

  <script is:inline>
    (() => {
      const buttons = [...document.querySelectorAll('[data-filter]')];
      const cards = [...document.querySelectorAll('[data-project]')];
      const status = document.querySelector('[data-filter-status]');
      const normalize = (value) => String(value || '').trim();

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const filter = normalize(button.getAttribute('data-filter'));
          let count = 0;
          cards.forEach((card) => {
            const keys = normalize(card.getAttribute('data-disciplines')).split(/\s+/);
            const show = filter === 'all' || keys.includes(filter);
            card.hidden = !show;
            if (show) count += 1;
          });
          buttons.forEach((item) => {
            const active = item === button;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-pressed', String(active));
          });
          if (status) status.textContent = `${count} project${count === 1 ? '' : 's'} shown.`;
        });
      });

      const copyButton = document.querySelector('[data-copy-email]');
      const copyStatus = document.querySelector('[data-copy-status]');
      if (copyButton) {
        copyButton.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText('izhaan.mubeen.me@gmail.com');
            if (copyStatus) copyStatus.textContent = 'Email copied to clipboard.';
          } catch {
            if (copyStatus) copyStatus.textContent = 'Copy failed — select the email address above.';
          }
        });
      }

      const contactIntentButtons = [...document.querySelectorAll('[data-contact-intent]')];
      const contactIntentTitle = document.querySelector('[data-contact-intent-title]');
      const contactIntentCopy = document.querySelector('[data-contact-intent-copy]');
      const contactMailLink = document.querySelector('[data-contact-mail-link]');

      contactIntentButtons.forEach((button) => {
        button.addEventListener('click', () => {
          contactIntentButtons.forEach((item) => {
            const active = item === button;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-pressed', String(active));
          });

          const title = button.getAttribute('data-title') || 'Engineering collaboration';
          const copy = button.getAttribute('data-copy') || '';
          const subject = button.getAttribute('data-subject') || title;
          if (contactIntentTitle) contactIntentTitle.textContent = title;
          if (contactIntentCopy) contactIntentCopy.textContent = copy;
          if (contactMailLink) contactMailLink.setAttribute('href', `mailto:izhaan.mubeen.me@gmail.com?subject=${encodeURIComponent(subject)}`);
        });
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const mechanicsTyping = document.querySelector('[data-mechanics-typing]');
      if (mechanicsTyping) {
        const mechanicsWord = 'mechanics';
        mechanicsTyping.textContent = '';

        if (reduceMotion) {
          mechanicsTyping.textContent = mechanicsWord;
        } else {
          let mechanicsIndex = 0;
          const typeMechanicsCharacter = () => {
            if (mechanicsIndex >= mechanicsWord.length) return;

            const character = document.createElement('span');
            character.className = 'hero-accent-word__char';
            character.textContent = mechanicsWord.charAt(mechanicsIndex);
            mechanicsTyping.appendChild(character);
            mechanicsIndex += 1;

            const nextDelay = mechanicsIndex === mechanicsWord.length ? 0 : 150 + Math.round(Math.random() * 35);
            if (nextDelay) window.setTimeout(typeMechanicsCharacter, nextDelay);
          };

          window.setTimeout(typeMechanicsCharacter, 520);
        }
      }

      const counterSections = [...document.querySelectorAll('[data-counter-section]')];
      const animateCounter = (element) => {
        if (!element || element.dataset.counted === 'true') return;
        const target = Number(element.getAttribute('data-count-to') || '0');
        if (reduceMotion) {
          element.textContent = String(target);
          element.dataset.counted = 'true';
          return;
        }

        const duration = 1250;
        const start = performance.now();
        element.dataset.counted = 'true';

        const tick = (now) => {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = Math.round(target * eased);
          element.textContent = String(current);
          if (progress < 1) {
            window.requestAnimationFrame(tick);
          } else {
            element.textContent = String(target);
          }
        };

        window.requestAnimationFrame(tick);
      };

      if ('IntersectionObserver' in window) {
        const counterObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.querySelectorAll('[data-count-to]').forEach((counter) => animateCounter(counter));
            counterObserver.unobserve(entry.target);
          });
        }, { threshold: 0.28, rootMargin: '0px 0px -8% 0px' });

        counterSections.forEach((section) => counterObserver.observe(section));
      } else {
        counterSections.forEach((section) => section.querySelectorAll('[data-count-to]').forEach((counter) => animateCounter(counter)));
      }

      const stackModules = [...document.querySelectorAll('[data-stack-index]')];
      const stackLayers = [...document.querySelectorAll('[data-stack-layer]')];
      const setStackActive = (index, active) => {
        stackLayers.forEach((layer) => {
          if (layer.getAttribute('data-stack-layer') === index) layer.classList.toggle('is-active', active);
        });
      };
      stackModules.forEach((module) => {
        const index = module.getAttribute('data-stack-index');
        module.addEventListener('pointerenter', () => setStackActive(index, true));
        module.addEventListener('pointerleave', () => setStackActive(index, false));
        module.addEventListener('focusin', () => setStackActive(index, true));
        module.addEventListener('focusout', () => setStackActive(index, false));
      });

      if (!reduceMotion && 'IntersectionObserver' in window) {
        const revealItems = [...document.querySelectorAll('.reveal')];
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        }, {
          // Start transitions before content actually reaches the viewport.
          // This removes the empty-background gap during fast wheel/trackpad scrolling.
          threshold: 0.01,
          rootMargin: '8% 0px 38% 0px'
        });

        revealItems.forEach((item) => {
          const rect = item.getBoundingClientRect();
          if (rect.top < window.innerHeight * 1.12) item.classList.add('is-visible');
          else revealObserver.observe(item);
        });
      } else {
        document.querySelectorAll('.reveal').forEach((item) => item.classList.add('is-visible'));
      }

      if ('IntersectionObserver' in window) {
        const navLinks = [...document.querySelectorAll('[data-nav-link]')];
        const sections = ['about', 'education', 'skills', 'projects', 'experience', 'contact']
          .map((id) => document.getElementById(id))
          .filter(Boolean);
        const sectionObserver = new IntersectionObserver((entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          navLinks.forEach((link) => {
            const active = link.getAttribute('href')?.endsWith(`#${visible.target.id}`);
            link.classList.toggle('is-current', Boolean(active));
          });
        }, { rootMargin: '-25% 0px -60% 0px', threshold: [0.01, 0.2, 0.5] });
        sections.forEach((section) => sectionObserver.observe(section));
      }
    })();
  </script>
</BaseLayout>
